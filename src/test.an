import Antest.Antest.run_tests
import AnteHttp.Tests.Helpers.register_helper_tests
import AnteHttp.Tests.Header.register_header_tests
import AnteHttp.Tests.Request.register_request_tests
import AnteHttp.Tests.Method.register_method_tests
import AnteHttp.Tests.Status.register_status_tests

main () =
    run_tests do
        register_helper_tests ()
        register_header_tests ()
        register_request_tests ()
        register_method_tests ()
        register_status_tests ()
