import Std.Throw.Throw, throw

export Socket, SocketError, SocketOperation, cast_socket_operation_string,
    print_socket_error, tcp_ipv4, set_reuse_address, bind_any_ipv4, listen,
    accept, receive, send, close

type Socket =
    descriptor: I32

type SocketOperation =
    | Create
    | SetReuseAddress
    | Bind
    | Listen
    | Accept

impl cast_socket_operation_string: Cast SocketOperation String pure with
    cast operation =
        match operation
        | SocketOperation.Create -> "socket"
        | SocketOperation.SetReuseAddress -> "setsockopt"
        | SocketOperation.Bind -> "bind"
        | SocketOperation.Listen -> "listen"
        | SocketOperation.Accept -> "accept"

type SocketError =
    operation: SocketOperation
    code: I32

impl print_socket_error: Display SocketError pure with
    print error =
        print "socket operation `"
        print (cast (deref error.operation) : String)
        print "` failed with errno "
        print error.code
        ()

c_tcp_ipv4: fn Unit -> I32 can Net = extern "ante_socket_tcp_ipv4"
c_set_reuse_address: fn I32 -> I32 can Net = extern "ante_socket_set_reuse_address"
c_bind_any_ipv4: fn I32 U16 -> I32 can Net = extern "ante_socket_bind_any_ipv4"
c_listen: fn I32 I32 -> I32 can Net = extern "ante_socket_listen"
c_accept: fn I32 -> I32 can Net = extern "ante_socket_accept"
c_receive: fn I32 (Ptr U8) Usz -> Isz can Net = extern "ante_socket_receive"
c_send: fn I32 (Ptr U8) Usz -> Isz can Net = extern "ante_socket_send"
c_close: fn I32 -> I32 can Net = extern "ante_socket_close"
c_errno: fn Unit -> I32 = extern "ante_socket_errno"

throw_socket_error (operation: SocketOperation): Never can Throw SocketError =
    throw (SocketError operation (c_errno ()))

tcp_ipv4 (): Socket can Net, Throw SocketError =
    socket = Socket (c_tcp_ipv4 ())
    if socket.descriptor < 0 then throw_socket_error SocketOperation.Create
    socket

set_reuse_address (socket: ref Socket): I32 can Net, Throw SocketError =
    result = c_set_reuse_address socket.descriptor
    if result < 0 then throw_socket_error SocketOperation.SetReuseAddress
    result

bind_any_ipv4 (socket: ref Socket) (port: U16): I32 can Net, Throw SocketError =
    result = c_bind_any_ipv4 socket.descriptor port
    if result < 0 then throw_socket_error SocketOperation.Bind
    result

listen (socket: ref Socket) (backlog: I32): I32 can Net, Throw SocketError =
    result = c_listen socket.descriptor backlog
    if result < 0 then throw_socket_error SocketOperation.Listen
    result

accept (socket: ref Socket): Socket can Net, Throw SocketError =
    result = Socket (c_accept socket.descriptor)
    if result.descriptor < 0 then throw_socket_error SocketOperation.Accept
    result

receive (socket: ref Socket) (buffer: Ptr U8) (length: Usz): Isz can Net =
    c_receive socket.descriptor buffer length

send (socket: ref Socket) (buffer: Ptr U8) (length: Usz): Isz can Net =
    c_send socket.descriptor buffer length

close (socket: ref Socket): I32 can Net =
    c_close socket.descriptor
