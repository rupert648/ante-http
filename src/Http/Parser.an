import Std.Fail.Fail, fail
import Std.String.eq_string
import Std.Vec.Vec
import AnteHttp.Http.Helpers.find_char_from, slice
import AnteHttp.Http.Request.Request
import AnteHttp.Http.Method.Method

export parse_request

strings_equal (left: ref String) (right: ref String): Bool =
    left == right

parse_method (method: ref String): Method can Fail =
    if strings_equal method "GET" then
        Method.Get
    else if strings_equal method "POST" then
        Method.Post
    else
        fail ()

find_line_end (text: ref String) (start: Usz): Usz can Fail =
    var index = start
    length = Usz text.length

    while index + 1 < length do
        if text.data.[index] == '\r'
            and text.data.[index + 1] == '\n'
        then
            return index

        index += 1

    fail ()

find_headers_end (text: ref String): Usz can Fail =
    var index = 0usz
    length = Usz text.length

    while index + 3 < length do
        if text.data.[index] == '\r'
            and text.data.[index + 1] == '\n'
            and text.data.[index + 2] == '\r'
            and text.data.[index + 3] == '\n'
        then
            return index

        index += 1

    fail ()

parse_headers (text: ref String) (request_line_end: Usz) (headers_end: Usz): Vec String can Fail, Fs =
    var headers = Vec.empty ()
    var header_start = request_line_end + 2

    while header_start < headers_end do
        header_end = find_line_end text header_start
        headers.push (slice text header_start header_end)
        header_start := header_end + 2

    headers

parse_request (raw: String): Request can Fail, Fs =
    method_end = find_char_from raw ' ' 0usz
    path_start = method_end + 1
    path_end = find_char_from raw ' ' path_start
    request_line_end = find_line_end raw (path_end + 1)
    headers_end = find_headers_end raw

    method = parse_method (slice raw 0usz method_end)
    path = slice raw path_start path_end
    headers = parse_headers raw request_line_end headers_end

    body_start = headers_end + 4
    body = slice raw body_start (Usz raw.length)

    Request method path headers body
