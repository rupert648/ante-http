import Std.Throw.Throw, throw
import Std.C.malloc, free
import AnteHttp.Socket.Socket, SocketError, print_socket_error, tcp_ipv4,
    set_reuse_address, any_ipv4, listen, bind, accept, receive, send, close

start_server (port: U16): Socket can IO, Throw SocketError =
    server_socket = tcp_ipv4 ()
    set_reuse_address server_socket
    address = any_ipv4 port
    bind server_socket address
    listen server_socket 128
    print "listening on http://localhost:"
    print port
    println ""

    server_socket

start_server_or_panic (port: U16): Socket can IO =
    handler h for throw error ->
        println error
        panic "failed to start HTTP server"
    start_server port

accept_retrying (server_socket: ref Socket): Socket can IO =
    handler h for throw error ->
        println error
        accept_retrying server_socket
    accept server_socket


main () =
    server_socket = start_server_or_panic 8080u16
    server_socket_ref = ref server_socket

    while true do
        client_socket = accept_retrying server_socket_ref

        // we can neaten up this API for sure
        buffer: Ptr U8 = malloc 65536
        bytes_read = receive client_socket buffer 65536

        if bytes_read > 0 then
            response = "HTTP/1.1 200 OK\r\nContent-Length:17\r\nContent-Type: text/plain\r\nConnection:close\r\n\r\nHello from Ante!\n"
            // feel like theres an api for this so check
            response_bytes = transmute response.data : Ptr U8

            _ = send client_socket response_bytes (Usz response.length)
            ()

        free buffer
        _ = close client_socket
        ()
    ()
